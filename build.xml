<?xml version="1.0" encoding="UTF-8"?>
<project name="PD1_Stankevics_27" default="compile" basedir=".">
    
    <property name="src.dir" value="src"/>
    <property name="test.dir" value="test"/>
    <property name="lib.dir" value="lib"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="test.classes.dir" value="${build.dir}/test-classes"/>
    <property name="report.dir" value="test-reports"/>
    <property name="main.class" value="pd1_stankevics_27.PD1_Stankevics_27"/>
    <property name="source.version" value="17"/>
    <property name="target.version" value="17"/>
    
    <path id="classpath">
        <pathelement location="${classes.dir}"/>
        <fileset dir="${lib.dir}" includes="*.jar" excludes="junit-platform-console-standalone-*.jar"/>
    </path>
    
    <path id="test.classpath">
        <pathelement location="${classes.dir}"/>
        <pathelement location="${test.classes.dir}"/>
        <fileset dir="${lib.dir}" includes="junit-platform-console-standalone-*.jar"/>
    </path>
    
    <target name="init">
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${test.classes.dir}"/>
        <mkdir dir="${report.dir}"/>
        <echo message="=== BUILD INITIALIZED ==="/>
    </target>
    
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${report.dir}"/>
        <echo message="=== BUILD CLEANED ==="/>
    </target>
    
    <target name="compile" depends="init">
        <echo message="=== COMPILING MAIN CODE ==="/>
        <javac srcdir="${src.dir}" destdir="${classes.dir}" 
               includeantruntime="false" debug="true" encoding="UTF-8"
               source="${source.version}" target="${target.version}">
            <classpath refid="classpath"/>
        </javac>
        <echo message="=== MAIN CODE COMPILED SUCCESSFULLY ==="/>
    </target>
    
    <target name="compile-tests" depends="compile">
        <echo message="=== COMPILING TESTS ==="/>
        <javac srcdir="${test.dir}" destdir="${test.classes.dir}" 
               includeantruntime="false" debug="true" encoding="UTF-8"
               source="${source.version}" target="${target.version}">
            <classpath refid="test.classpath"/>
        </javac>
        <echo message="=== TESTS COMPILED SUCCESSFULLY ==="/>
    </target>
    
    <target name="test" depends="compile-tests">
        <echo message="=== RUNNING TESTS ==="/>
        <java classname="org.junit.platform.console.ConsoleLauncher" 
              fork="true" failonerror="false">
            <classpath>
                <pathelement location="${classes.dir}"/>
                <pathelement location="${test.classes.dir}"/>
                <fileset dir="${lib.dir}" includes="junit-platform-console-standalone-*.jar"/>
            </classpath>
            <arg value="--scan-classpath"/>
            <arg value="--classpath"/>
            <arg value="${test.classes.dir}"/>
            <arg value="--include-classname"/>
            <arg value=".*Test.*"/>
            <arg value="--details"/>
            <arg value="tree"/>
        </java>
    </target>
    
    <target name="run" depends="compile">
        <java classname="${main.class}" fork="true">
            <classpath refid="classpath"/>
        </java>
    </target>
    
    <target name="build-and-test" depends="clean, compile, test">
        <echo message="=== BUILD AND TEST COMPLETED ==="/>
    </target>
    
    <target name="help">
        <echo message="======================================="/>
        <echo message="  ant clean        - Clean build"/>
        <echo message="  ant compile      - Compile main code"/>
        <echo message="  ant compile-tests - Compile tests"/>
        <echo message="  ant test         - Run all tests"/>
        <echo message="  ant run          - Run main program"/>
        <echo message="  ant build-and-test - Clean, compile and test"/>
        <echo message="======================================="/>
    </target>
    
</project>